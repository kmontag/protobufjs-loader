{
  "name": "protobufjs-loader",
  "version": "0.0.0-development",
  "description": "Webpack loader to translate .proto definitions to ProtoBuf.js modules",
  "main": "index.js",
  "scripts": {
    "check": "tsc",
    "fix:script": "eslint --fix .",
    "fix:style": "prettier --write .",
    "fix": "npm run fix:script && npm run fix:style",
    "lint:script": "eslint .",
    "lint:style": "prettier -c .",
    "lint": "npm run lint:script && npm run lint:style",
    "test": "mocha test/*.test.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "webpack",
    "protobuf",
    "protobufjs",
    "ProtoBuf.js"
  ],
  "author": "Kevin Montag <kmontag@cs.stanford.edu>",
  "license": "MIT",
  "dependencies": {
    "schema-utils": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/chai": "^4.3.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.0.0",
    "@types/uglify-js": "^3.17.5",
    "chai": "^4.5.0",
    "conventional-changelog-conventionalcommits": "^10.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-mocha": "^11.0.0",
    "glob": "^13.0.0",
    "globals": "^17.0.0",
    "inspect-loader": "^1.0.0",
    "memfs": "^4.64.0",
    "mocha": "^11.0.0",
    "prettier": "^3.0.0",
    "protobufjs": "^8.0.0",
    "protobufjs-cli": "^2.0.0",
    "semantic-release": "^25.0.2",
    "typescript": "^7.0.0",
    "uglify-js": "^3.19.3",
    "webpack": "^5.0.0"
  },
  "peerDependencies": {
    "protobufjs": "^7.0.0 || ^8.0.0",
    "protobufjs-cli": "^1.0.0 || ^2.0.0",
    "webpack": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kmontag/protobufjs-loader.git"
  }
}
